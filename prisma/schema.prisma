// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          Role     @default(USER)
  avatarUrl     String?
  isVerified    Boolean  @default(false)
  /// When the user accepted the Privacy Policy at sign-up (consent record). Null for accounts created before it was asked.
  privacyAcceptedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
  payments      Payment[]
  sessions      Session[]
  supportTickets SupportTicket[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String      @db.Text
  category    Category
  status      ProductStatus @default(ACTIVE)
  features    Json
  specs       Json
  imageUrl    String?
  /// Units left to sell. NULL = not tracked (unlimited). Each new subscription
  /// uses one unit; at 0 the product is hidden from the public catalogue and
  /// cannot be bought.
  inventoryCount Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  plans         Plan[]
  subscriptions Subscription[]

  @@map("products")
}

model Plan {
  id            String   @id @default(cuid())
  productId     String
  name          String
  description   String?
  price         Decimal  @db.Decimal(10, 2)
  billingCycle  BillingCycle @default(MONTHLY)
  isPopular     Boolean  @default(false)
  /// Soft delete: existing subscriptions keep referencing the plan, but it is
  /// hidden from the catalogue and cannot be purchased.
  isDeleted     Boolean  @default(false)
  limits        Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id           String             @id @default(cuid())
  userId       String
  productId    String
  planId       String
  status       SubscriptionStatus @default(ACTIVE)
  startDate    DateTime           @default(now())
  endDate      DateTime?
  renewsAt     DateTime?
  cancelledAt  DateTime?
  metadata     Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user         User     @relation(fields: [userId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])
  plan         Plan     @relation(fields: [planId], references: [id])
  payments     Payment[]
  serviceConfig ServiceConfig?
  provisioningJob ProvisioningJob?

  @@index([status, renewsAt])
  @@map("subscriptions")
}

model ServiceConfig {
  id             String   @id @default(cuid())
  subscriptionId String   @unique
  hostname       String?
  ipAddress      String?
  domain         String?
  /// Encrypted at rest: { enc: "v1:<iv>:<tag>:<ciphertext>" } — see src/lib/crypto.ts.
  /// Never returned to clients; use src/lib/serializers.ts.
  credentials    Json?
  config         Json?
  region         String?
  /// SHA-256 (hex) of the server's SSH host key. Supplied at provisioning time
  /// when the provider knows it, otherwise pinned on first connect.
  hostKeySha256  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("service_configs")
}

/// One job per subscription: turns a paid order into a real service.
model ProvisioningJob {
  id             String            @id @default(cuid())
  subscriptionId String            @unique
  status         ProvisioningStatus @default(QUEUED)
  attempts       Int               @default(0)
  lastError      String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
  @@map("provisioning_jobs")
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  subscriptionId String?
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("INR")
  status         PaymentStatus @default(PENDING)
  method         PaymentMethod @default(CARD)
  /// Unique so a gateway payment can only ever be fulfilled once (idempotency).
  gatewayId      String?       @unique
  gatewayData    Json?
  invoiceUrl     String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("payments")
}

model SupportTicket {
  id        String       @id @default(cuid())
  userId    String
  subject   String
  body      String       @db.Text
  status    TicketStatus @default(OPEN)
  priority  Priority     @default(MEDIUM)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user    User            @relation(fields: [userId], references: [id])
  replies TicketReply[]

  @@map("support_tickets")
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String   @db.Text
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_replies")
}

/// Messages submitted through the public Contact Us form.
model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@map("contact_messages")
}

enum ContactStatus {
  NEW
  READ
  RESOLVED
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum Category {
  VPS
  DOCKER
  EMAIL
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  COMING_SOON
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
  TRIAL
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  PAYPAL
  CRYPTO
  BANK_TRANSFER
  UPI
  NETBANKING
  WALLET
}

enum ProvisioningStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
