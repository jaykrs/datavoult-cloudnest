// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          Role     @default(USER)
  avatarUrl     String?
  isVerified    Boolean  @default(false)
  /// When the user accepted the Privacy Policy at sign-up (consent record). Null for accounts created before it was asked.
  privacyAcceptedAt DateTime?
  /// Billing details for invoices (all optional; GSTIN only if the customer is GST-registered).
  billingName      String?
  billingGstin     String?
  billingAddress   String?  @db.Text
  /// GST state code (e.g. "29") of the customer, used for CGST+SGST vs IGST.
  billingStateCode String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
  payments      Payment[]
  paymentRequests PaymentRequest[]
  invoices      Invoice[]
  blogPosts     BlogPost[]
  deployments   Deployment[]
  sessions      Session[]
  supportTickets SupportTicket[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String      @db.Text
  category    Category
  status      ProductStatus @default(ACTIVE)
  features    Json
  specs       Json
  imageUrl    String?
  /// GST percentage charged on this product; NULL = no GST.
  gstRate        Decimal? @db.Decimal(5, 2)
  /// true: listed prices already include GST. false: GST is added on top at checkout.
  gstInclusive   Boolean  @default(true)
  /// GST service accounting code shown on invoices (defaults to 998315 in the app).
  sacCode        String?
  /// SEO / marketing metadata for the product page (all optional; sensible defaults are derived).
  metaTitle       String? @db.VarChar(255)
  metaDescription String? @db.VarChar(320)
  metaKeywords    String? @db.VarChar(255)
  /// Image used for link previews (Open Graph / Twitter). Falls back to imageUrl.
  ogImageUrl      String? @db.VarChar(500)
  /// Units left to sell. NULL = not tracked (unlimited). Each new subscription
  /// uses one unit; at 0 the product is hidden from the public catalogue and
  /// cannot be bought.
  inventoryCount Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  plans         Plan[]
  subscriptions Subscription[]
  paymentRequests PaymentRequest[]

  @@map("products")
}

model Plan {
  id            String   @id @default(cuid())
  productId     String
  name          String
  description   String?
  /// Price of ONE DAY of service in INR. Customers buy a whole number of days
  /// (minimum 30) and pay price x days — see src/lib/pricing.ts.
  price         Decimal  @db.Decimal(10, 2)
  isPopular     Boolean  @default(false)
  /// Soft delete: existing subscriptions keep referencing the plan, but it is
  /// hidden from the catalogue and cannot be purchased.
  isDeleted     Boolean  @default(false)
  limits        Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  paymentRequests PaymentRequest[]

  @@map("plans")
}

model Subscription {
  id           String             @id @default(cuid())
  userId       String
  productId    String
  planId       String
  status       SubscriptionStatus @default(ACTIVE)
  startDate    DateTime           @default(now())
  endDate      DateTime?
  renewsAt     DateTime?
  cancelledAt  DateTime?
  metadata     Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user         User     @relation(fields: [userId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])
  plan         Plan     @relation(fields: [planId], references: [id])
  payments     Payment[]
  serviceConfig ServiceConfig?
  provisioningJob ProvisioningJob?
  deployments   Deployment[]

  @@index([status, renewsAt])
  @@map("subscriptions")
}

model ServiceConfig {
  id             String   @id @default(cuid())
  subscriptionId String   @unique
  hostname       String?
  ipAddress      String?
  domain         String?
  /// Encrypted at rest: { enc: "v1:<iv>:<tag>:<ciphertext>" } — see src/lib/crypto.ts.
  /// Never returned to clients; use src/lib/serializers.ts.
  credentials    Json?
  config         Json?
  region         String?
  /// SHA-256 (hex) of the server's SSH host key. Supplied at provisioning time
  /// when the provider knows it, otherwise pinned on first connect.
  hostKeySha256  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("service_configs")
}

/// One job per subscription: turns a paid order into a real service.
model ProvisioningJob {
  id             String            @id @default(cuid())
  subscriptionId String            @unique
  status         ProvisioningStatus @default(QUEUED)
  attempts       Int               @default(0)
  lastError      String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
  @@map("provisioning_jobs")
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  subscriptionId String?
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("INR")
  status         PaymentStatus @default(PENDING)
  method         PaymentMethod @default(CARD)
  /// Unique so a gateway payment can only ever be fulfilled once (idempotency).
  gatewayId      String?       @unique
  gatewayData    Json?
  invoiceUrl     String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  invoice      Invoice?

  @@map("payments")
}

/// A customer's offline payment (UPI or bank transfer) waiting for an admin to
/// confirm the money arrived. Approval runs the same fulfilment as an online payment.
model PaymentRequest {
  id             String               @id @default(cuid())
  /// Short code the customer puts in the transfer remark, e.g. DV-7K3M9QXA.
  reference      String               @unique
  userId         String
  productId      String
  planId         String
  /// Set when the order renews an existing subscription.
  subscriptionId String?
  days           Int
  /// Exact amount in INR the customer must transfer (plan price x days).
  amount         Decimal              @db.Decimal(10, 2)
  method         PaymentMethod
  status         PaymentRequestStatus @default(AWAITING_PAYMENT)
  /// UTR / bank reference the customer entered after paying.
  transactionRef String?
  /// Payer name / UPI ID as entered by the customer, to help match the bank statement.
  payerDetails   String?
  submittedAt    DateTime?
  expiresAt      DateTime
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  /// The subscription created or renewed on approval.
  resultSubscriptionId String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  plan    Plan    @relation(fields: [planId], references: [id])

  @@index([status, createdAt])
  @@index([userId, status])
  @@index([transactionRef])
  @@map("payment_requests")
}

/// One invoice per completed payment (any method). Amounts are snapshots taken at
/// payment time, so later price/GST/profile changes never alter an issued invoice.
model Invoice {
  id             String   @id @default(cuid())
  /// Sequential per financial year, max 16 chars (GST rule), e.g. DV2627-000042.
  number         String   @unique
  /// Financial year label, e.g. 2026-27.
  fy             String
  paymentId      String   @unique
  userId         String
  subscriptionId String?
  issuedAt       DateTime @default(now())
  description    String
  sacCode        String?
  days           Int?
  /// Value before GST.
  taxableAmount  Decimal  @db.Decimal(10, 2)
  /// 0 when the product carries no GST.
  gstRate        Decimal  @db.Decimal(5, 2)
  cgst           Decimal  @db.Decimal(10, 2)
  sgst           Decimal  @db.Decimal(10, 2)
  igst           Decimal  @db.Decimal(10, 2)
  /// What the customer paid (equals the payment amount).
  total          Decimal  @db.Decimal(10, 2)
  placeOfSupply  String?
  /// Seller and buyer details as they were when the invoice was issued.
  seller         Json
  buyer          Json
  createdAt      DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId, issuedAt])
  @@map("invoices")
}

/// Last invoice serial used per financial year (key like "2627"); gives gap-free numbering.
model InvoiceCounter {
  id         String @id
  lastNumber Int

  @@map("invoice_counters")
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model BlogCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts BlogPost[]

  @@map("blog_categories")
}

/// Marketing blog post. `content` is HTML, sanitised on save (see src/lib/html-sanitize.ts).
model BlogPost {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  excerpt         String?    @db.VarChar(500)
  content         String     @db.LongText
  coverImageUrl   String?    @db.VarChar(500)
  categoryId      String?
  authorId        String?
  status          BlogStatus @default(DRAFT)
  /// Visible on the public site once status is PUBLISHED and this time has passed.
  publishedAt     DateTime?
  metaTitle       String?    @db.VarChar(255)
  metaDescription String?    @db.VarChar(320)
  ogImageUrl      String?    @db.VarChar(500)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("blog_posts")
}

/// Images uploaded from the admin editor, stored in the database so the app needs no
/// shared disk or object store. Served from /api/media/:id.
model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  mimeType     String
  size         Int
  data         Bytes    @db.LongBlob
  uploadedById String?
  createdAt    DateTime @default(now())

  @@map("media_assets")
}

model SupportTicket {
  id        String       @id @default(cuid())
  userId    String
  subject   String
  body      String       @db.Text
  status    TicketStatus @default(OPEN)
  priority  Priority     @default(MEDIUM)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user    User            @relation(fields: [userId], references: [id])
  replies TicketReply[]

  @@map("support_tickets")
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String   @db.Text
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_replies")
}

/// Messages submitted through the public Contact Us form.
model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@map("contact_messages")
}

enum ContactStatus {
  NEW
  READ
  RESOLVED
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum Category {
  VPS
  DOCKER
  EMAIL
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  COMING_SOON
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
  TRIAL
}

enum PaymentRequestStatus {
  AWAITING_PAYMENT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  PAYPAL
  CRYPTO
  BANK_TRANSFER
  UPI
  NETBANKING
  WALLET
}

enum ProvisioningStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DeploymentMode {
  PM2
  DOCKER
}

enum HttpsMode {
  NONE
  SELF_SIGNED
  LETSENCRYPT
}

enum DeploymentStatus {
  DEPLOYING
  RUNNING
  FAILED
}

/// A customer application deployed (git clone, build, run, nginx proxy) onto their VPS.
model Deployment {
  id             String           @id @default(cuid())
  subscriptionId String
  userId         String
  /// Safe name used for the process/container/nginx file (derived from repo name + port).
  appName        String           @db.VarChar(80)
  repoUrl        String           @db.VarChar(500)
  branch         String           @db.VarChar(100)
  port           Int
  mode           DeploymentMode
  httpsMode      HttpsMode
  domain         String?          @db.VarChar(253)
  /// Encrypted JSON array of {key,value} environment variables (see src/lib/crypto.ts). Never returned to clients.
  envEnc         String?          @db.LongText
  status         DeploymentStatus @default(DEPLOYING)
  /// Tail of the latest run's output.
  log            String?          @db.LongText
  lastDeployedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([subscriptionId, port])
  @@index([userId])
  @@map("deployments")
}
