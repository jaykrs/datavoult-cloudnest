# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://user:password@localhost:3306/datavoult"
JWT_SECRET=""            # openssl rand -base64 48 (min 32 chars)
CREDENTIALS_ENCRYPTION_KEY=""  # openssl rand -hex 32 (encrypts customer server credentials)

# ── Razorpay ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
CRON_SECRET=""           # bearer token for /api/internal/* scheduler calls

# ── Google reCAPTCHA v2 (checkbox) — sign in, sign up, contact form ─────────
# Keys: https://www.google.com/recaptcha/admin  (register a "v2 Checkbox" site)
# Production REFUSES these forms when the secret is missing; in development both
# may stay empty and the check is skipped.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# ── Google Tag Manager (loaded only after the visitor accepts cookies) ──────
NEXT_PUBLIC_GTM_ID=""    # e.g. GTM-XXXXXXX

# ── Email notifications (SMTP) ──────────────────────────────────────────────
# Optional: without SMTP_HOST + MAIL_FROM emails are skipped (logged), never fatal.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"      # "true" for port 465
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="DataVoult <no-reply@example.com>"
ADMIN_NOTIFY_EMAIL=""    # comma-separated; gets new-signup, new-order and contact alerts

# ── Offline payments: UPI + bank transfer (verified by an admin) ────────────
# Customers are shown these details at checkout. A method is only offered when its
# details are complete; IFSC and UPI ID are format-checked. Use your CURRENT account.
BANK_ACCOUNT_NAME=""     # name exactly as on the account
BANK_ACCOUNT_NUMBER=""
BANK_IFSC=""             # e.g. HDFC0001234
BANK_NAME=""             # e.g. HDFC Bank
BANK_BRANCH=""           # optional
BANK_ACCOUNT_TYPE="Current"
UPI_ID=""                # e.g. yourbusiness@okhdfcbank
UPI_PAYEE_NAME=""        # optional; defaults to BANK_ACCOUNT_NAME

# ── Optional tuning ─────────────────────────────────────────────────────────
# PROVISIONING_PROVIDER="manual"   # or "mock"
# DEFAULT_REGION=""
# RENEWAL_GRACE_DAYS="3"
# SUSPENDED_EXPIRE_DAYS="14"
# DEPLOY_ALLOWED_GIT_HOSTS="github.com,gitlab.com"
